 * SPDX-License-Identifier: MIT
 *
 * Hand-wired 65% ANSI keyboard (CIDOO case)
 * Board: Pro Micro NRF52840 (nice!nano compatible clone)
 * Matrix: 5 rows x 15 columns = 75 positions (68 used)
 *
 * Physical layout:
 * ┌───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬─────┬───┐
 * │Esc│ 1 │ 2 │ 3 │ 4 │ 5 │ 6 │ 7 │ 8 │ 9 │ 0 │ - │ = │Bksp │Del│
 * ├───┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬───┴───┤
 * │ Tab │ Q │ W │ E │ R │ T │ Y │ U │ I │ O │ P │ [ │ ] │  \  │PgU│
 * ├─────┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴─────┬───┤
 * │ Caps │ A │ S │ D │ F │ G │ H │ J │ K │ L │ ; │ ' │ Enter  │PgD│
 * ├──────┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬───┬───┬───┤
 * │ Shift  │ Z │ X │ C │ V │ B │ N │ M │ , │ . │ / │Sft│ ▲ │End│
 * ├────┬───┴┬──┴─┬─┴───┴───┴───┴───┴───┴──┬┴──┬┴──┬┴──┬───┬───┬───┤
 * │Ctrl│GUI │Alt │         Space           │Alt│Fn │Ctl│ ◄ │ ▼ │ ► │
 * └────┴────┴────┴─────────────────────────┴───┴───┴───┴───┴───┴───┘
 *
 * Wiring guide (Pro Micro NRF52840):
 *
 *  MCU Left Side          MCU Right Side       Extra Pads (bottom)
 *  ─────────────          ──────────────       ───────────────────
 *  D1  / P0.06 → ROW0    D21 / P0.31 → COL7   P1.01 → ROW2
 *  D0  / P0.08 → ROW1    D20 / P0.29 → COL8   P1.02 → ROW3
 *  GND                    D19 / P0.02 → COL9   P1.07 → ROW4
 *  GND                    D18 / P1.15 → COL10
 *  D2  / P0.17 → (free)  D15 / P1.13 → COL11
 *  D3  / P0.20 → COL0    D14 / P1.11 → COL12
 *  D4  / P0.22 → COL1    D16 / P0.10 → COL13
 *  D5  / P0.24 → COL2    D10 / P0.09 → COL14
 *  D6  / P1.00 → COL3
 *  D7  / P0.11 → COL4
 *  D8  / P1.04 → COL5
 *  D9  / P1.06 → COL6
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &hw65_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <5>;

        /*
         * NOTE: This transform assumes standard 65% ANSI stagger.
         * Positions marked with &none in the keymap are suspected
         * empty matrix positions (no physical switch). You may need
         * to adjust after testing which matrix positions fire.
         */
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        /*
         * IMPORTANT: Using raw nRF52840 GPIO references because this
         * Pro Micro NRF52840 clone has different pin mappings than the
         * nice!nano v2. Do NOT use &pro_micro references with this board.
         *
         * Rows use D1, D0 (header) + P1.01, P1.02, P1.07 (bottom pads).
         * Columns use D3-D10, D14-D16, D18-D21 (all header pins).
         */

        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW0 - D1    */
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW1 - D0    */
            , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW2 - P1.01 */
            , <&gpio1 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW3 - P1.02 */
            , <&gpio1 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW4 - P1.07 */
            ;

        col-gpios
            = <&gpio0 20 GPIO_ACTIVE_HIGH>  /* COL0  - D3  (front-left)  */
            , <&gpio0 22 GPIO_ACTIVE_HIGH>  /* COL1  - D4  */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  /* COL2  - D5  */
            , <&gpio1 0  GPIO_ACTIVE_HIGH>  /* COL3  - D6  */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>  /* COL4  - D7  */
            , <&gpio1 4  GPIO_ACTIVE_HIGH>  /* COL5  - D8  */
            , <&gpio1 6  GPIO_ACTIVE_HIGH>  /* COL6  - D9  */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>  /* COL7  - D21 */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  /* COL8  - D20 */
            , <&gpio0 2  GPIO_ACTIVE_HIGH>  /* COL9  - D19 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  /* COL10 - D18 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  /* COL11 - D15 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>  /* COL12 - D14 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  /* COL13 - D16 */
            , <&gpio0 9  GPIO_ACTIVE_HIGH>  /* COL14 - D10 (front-right) */
            ;
    };

    hw65_layout: hw65_layout {
        compatible = "zmk,physical-layout";
        display-name = "65%";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys
            = <&key_physical_attrs 100 100 0 0 0 0 0>  /* pos 0 */
            , <&key_physical_attrs 100 100 100 0 0 0 0>  /* pos 1 */
            , <&key_physical_attrs 100 100 200 0 0 0 0>  /* pos 2 */
            , <&key_physical_attrs 100 100 300 0 0 0 0>  /* pos 3 */
            , <&key_physical_attrs 100 100 400 0 0 0 0>  /* pos 4 */
            , <&key_physical_attrs 100 100 500 0 0 0 0>  /* pos 5 */
            , <&key_physical_attrs 100 100 600 0 0 0 0>  /* pos 6 */
            , <&key_physical_attrs 100 100 700 0 0 0 0>  /* pos 7 */
            , <&key_physical_attrs 100 100 800 0 0 0 0>  /* pos 8 */
            , <&key_physical_attrs 100 100 900 0 0 0 0>  /* pos 9 */
            , <&key_physical_attrs 100 100 1000 0 0 0 0>  /* pos 10 */
            , <&key_physical_attrs 100 100 1100 0 0 0 0>  /* pos 11 */
            , <&key_physical_attrs 100 100 1200 0 0 0 0>  /* pos 12 */
            , <&key_physical_attrs 100 100 1300 0 0 0 0>  /* pos 13 */
            , <&key_physical_attrs 100 100 1400 0 0 0 0>  /* pos 14 */
            , <&key_physical_attrs 100 100 0 100 0 0 0>  /* pos 15 */
            , <&key_physical_attrs 100 100 100 100 0 0 0>  /* pos 16 */
            , <&key_physical_attrs 100 100 200 100 0 0 0>  /* pos 17 */
            , <&key_physical_attrs 100 100 300 100 0 0 0>  /* pos 18 */
            , <&key_physical_attrs 100 100 400 100 0 0 0>  /* pos 19 */
            , <&key_physical_attrs 100 100 500 100 0 0 0>  /* pos 20 */
            , <&key_physical_attrs 100 100 600 100 0 0 0>  /* pos 21 */
            , <&key_physical_attrs 100 100 700 100 0 0 0>  /* pos 22 */
            , <&key_physical_attrs 100 100 800 100 0 0 0>  /* pos 23 */
            , <&key_physical_attrs 100 100 900 100 0 0 0>  /* pos 24 */
            , <&key_physical_attrs 100 100 1000 100 0 0 0>  /* pos 25 */
            , <&key_physical_attrs 100 100 1100 100 0 0 0>  /* pos 26 */
            , <&key_physical_attrs 100 100 1200 100 0 0 0>  /* pos 27 */
            , <&key_physical_attrs 100 100 1300 100 0 0 0>  /* pos 28 */
            , <&key_physical_attrs 100 100 1400 100 0 0 0>  /* pos 29 */
            , <&key_physical_attrs 100 100 0 200 0 0 0>  /* pos 30 */
            , <&key_physical_attrs 100 100 100 200 0 0 0>  /* pos 31 */
            , <&key_physical_attrs 100 100 200 200 0 0 0>  /* pos 32 */
            , <&key_physical_attrs 100 100 300 200 0 0 0>  /* pos 33 */
            , <&key_physical_attrs 100 100 400 200 0 0 0>  /* pos 34 */
            , <&key_physical_attrs 100 100 500 200 0 0 0>  /* pos 35 */
            , <&key_physical_attrs 100 100 600 200 0 0 0>  /* pos 36 */
            , <&key_physical_attrs 100 100 700 200 0 0 0>  /* pos 37 */
            , <&key_physical_attrs 100 100 800 200 0 0 0>  /* pos 38 */
            , <&key_physical_attrs 100 100 900 200 0 0 0>  /* pos 39 */
            , <&key_physical_attrs 100 100 1000 200 0 0 0>  /* pos 40 */
            , <&key_physical_attrs 100 100 1100 200 0 0 0>  /* pos 41 */
            , <&key_physical_attrs 0 0 1200 200 0 0 0>  /* gap pos 42 */
            , <&key_physical_attrs 100 100 1300 200 0 0 0>  /* pos 43 */
            , <&key_physical_attrs 100 100 1400 200 0 0 0>  /* pos 44 */
            , <&key_physical_attrs 100 100 0 300 0 0 0>  /* pos 45 */
            , <&key_physical_attrs 100 100 100 300 0 0 0>  /* pos 46 */
            , <&key_physical_attrs 100 100 200 300 0 0 0>  /* pos 47 */
            , <&key_physical_attrs 100 100 300 300 0 0 0>  /* pos 48 */
            , <&key_physical_attrs 100 100 400 300 0 0 0>  /* pos 49 */
            , <&key_physical_attrs 100 100 500 300 0 0 0>  /* pos 50 */
            , <&key_physical_attrs 100 100 600 300 0 0 0>  /* pos 51 */
            , <&key_physical_attrs 100 100 700 300 0 0 0>  /* pos 52 */
            , <&key_physical_attrs 100 100 800 300 0 0 0>  /* pos 53 */
            , <&key_physical_attrs 100 100 900 300 0 0 0>  /* pos 54 */
            , <&key_physical_attrs 100 100 1000 300 0 0 0>  /* pos 55 */
            , <&key_physical_attrs 0 0 1100 300 0 0 0>  /* gap pos 56 */
            , <&key_physical_attrs 100 100 1200 300 0 0 0>  /* pos 57 */
            , <&key_physical_attrs 100 100 1300 300 0 0 0>  /* pos 58 */
            , <&key_physical_attrs 100 100 1400 300 0 0 0>  /* pos 59 */
            , <&key_physical_attrs 100 100 0 400 0 0 0>  /* pos 60 */
            , <&key_physical_attrs 100 100 100 400 0 0 0>  /* pos 61 */
            , <&key_physical_attrs 100 100 200 400 0 0 0>  /* pos 62 */
            , <&key_physical_attrs 0 0 300 400 0 0 0>  /* gap pos 63 */
            , <&key_physical_attrs 0 0 400 400 0 0 0>  /* gap pos 64 */
            , <&key_physical_attrs 100 100 500 400 0 0 0>  /* pos 65 */
            , <&key_physical_attrs 0 0 600 400 0 0 0>  /* gap pos 66 */
            , <&key_physical_attrs 0 0 700 400 0 0 0>  /* gap pos 67 */
            , <&key_physical_attrs 0 0 800 400 0 0 0>  /* gap pos 68 */
            , <&key_physical_attrs 100 100 900 400 0 0 0>  /* pos 69 */
            , <&key_physical_attrs 100 100 1000 400 0 0 0>  /* pos 70 */
            , <&key_physical_attrs 100 100 1100 400 0 0 0>  /* pos 71 */
            , <&key_physical_attrs 100 100 1200 400 0 0 0>  /* pos 72 */
            , <&key_physical_attrs 100 100 1300 400 0 0 0>  /* pos 73 */
            , <&key_physical_attrs 100 100 1400 400 0 0 0>  /* pos 74 */
            ;
    };
};
